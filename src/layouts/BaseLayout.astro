---
import "../../design-system/tokens.css";
import "../styles/components.css";
import "../styles/site.css";
import "../styles/legacy.css";
import Header from "../components/Header.astro";
import DarkEnd from "../components/DarkEnd.astro";
import Newsletter from "../components/Newsletter.astro";
import { personJsonLd } from "../lib/seo";
import { site, type NavKey } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  current?: NavKey;
  image?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.description, current, image = "/og/site.png", jsonLd } = Astro.props;
/** A page that fills the dark ending itself (About, with its contact band) has no newsletter of its own. */
const hasOwnEnding = Astro.slots.has("ending");
const documentTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:type" content={jsonLd ? "article" : "website"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={site.xHandle} />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {verification ? <meta name="google-site-verification" content={verification} /> : null}
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd())} />
    {jsonLd ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("theme") === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={current} subscribeHref={hasOwnEnding ? "/#newsletter" : "#newsletter"} />
    <main id="main">
      <slot />
    </main>
    <DarkEnd>
      <slot name="ending"><Newsletter /></slot>
    </DarkEnd>
    <script>
      import "../scripts/shell.ts";
    </script>
    {
      beacon ? (
        <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token":"${beacon}"}`} />
      ) : null
    }
  </body>
</html>
