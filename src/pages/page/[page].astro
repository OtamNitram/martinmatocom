---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, pageCount, postsForPage } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const pages = pageCount(posts.length);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page } };
  });
}

const { page } = Astro.props;
const posts = await getPosts();
const pagePosts = postsForPage(posts, page);
const nextHref = page < pageCount(posts.length) ? `/page/${page + 1}` : undefined;
---

<BaseLayout title={`Older entries, page ${page}`} current="blog">
  <div class="page">
    <div class="page__intro">
      <p class="type-caption-mono">Talking Dev</p>
      <h1 class="type-h1">Older entries</h1>
    </div>
    <PostList posts={pagePosts} total={pagePosts.length} nextHref={nextHref} />
  </div>
</BaseLayout>
