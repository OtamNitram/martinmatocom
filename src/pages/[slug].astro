---
import { Image } from "astro:assets";
import { render } from "astro:content";
import portrait from "../../design-system/assets/photos/portrait-headshot.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import Chip from "../components/Chip.astro";
import ClosingPrompt from "../components/ClosingPrompt.astro";
import Newsletter from "../components/Newsletter.astro";
import { formatDate, getPosts, readTime, replyHref } from "../lib/posts";
import { postJsonLd } from "../lib/seo";
import { site } from "../lib/site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readTime(post.body ?? "");
---

<BaseLayout title={post.data.title} description={post.data.description} current="blog" image={`/og/${post.id}.png`} jsonLd={postJsonLd(post)}>
  <div class="page page--post">
    <p class="post-back"><a href="/">All stories</a></p>
    <article class="mw-article">
      <header class="mw-article__head">
        <div class="mw-post__meta">
          <Chip topic={post.data.topic}>{post.data.topic}</Chip>
          <span class="mw-post__date">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            {" · "}
            {minutes}
          </span>
        </div>
        <h1 class="mw-article__title">{post.data.title}</h1>
      </header>
      <div class="mw-article__body">
        <figure class="author">
          <Image src={portrait} alt="Portrait of Martín Mato" width={200} height={250} />
          <figcaption>
            <span class="author__name">{site.name}</span>
            <span class="author__role">{site.authorLine}</span>
          </figcaption>
        </figure>
        <Content />
      </div>
      <ClosingPrompt question={post.data.closingQuestion} href={replyHref(post)} />
    </article>
  </div>
  <Newsletter />
</BaseLayout>
