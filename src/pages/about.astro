---
import { Image } from "astro:assets";
import night from "../../design-system/assets/photos/about-night-notebook.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import TopicTag from "../components/TopicTag.astro";
import { catchPhrase, formatDate, readTime, startPosts } from "../lib/posts";
import { site } from "../lib/site";
import "../styles/about.css";

const start = await startPosts();

const story = [
  {
    when: "2008 · Before code",
    title: "The long way in",
    text: "I fixed PCs, answered phones at a call center, and spent four years in QA before I wrote code for a living.",
  },
  {
    when: "2016 · First job as a developer",
    title: "Laid off for working alone",
    text: "Seven months into my first job as a junior developer, I was at the top of the layoff list. I blamed everyone and everything instead of looking at my part.",
    link: { href: "/the-armor-i-called-confidence", label: "Read the full story →" },
  },
  {
    when: "2017 · From QA to tech lead",
    title: "My first team",
    text: "Leading a team for the first time taught me to listen before fixing. For a while, it stuck.",
  },
  {
    when: "2018 · A new job",
    title: "A company with no bosses",
    text: "Here every decision is earned through conversation. I slipped back into knowing it all, until my colleagues were honest enough to tell me.",
  },
  {
    when: "Today",
    title: "Where I am now",
    text: "I lead teams for clients in the US, mentor people who are starting to lead, and bring AI into how we work. I still write code when it’s needed. It keeps me close to what the team actually deals with.",
    today: true,
  },
];

const ideas = [
  {
    title: "Team building",
    text: "Continuous improvement, done by the team itself. I try to build teams that iterate toward quality on their own, not because someone asks them to.",
  },
  {
    title: "Psychological safety",
    text: "People only try new things, AI included, when they feel safe to get it wrong. The hard part isn’t the tool. It’s adoption, trust, and knowing where to draw the line.",
  },
  {
    title: "Ontological coaching",
    text: "A human-centered way to grow as a professional. I lean on it when I listen, give feedback or lead.",
  },
];
---

<BaseLayout
  title="About"
  description="Martín Mato leads software teams from Montevideo, Uruguay. How he got here, how he works, and where to start reading."
  current="about"
>
  <section class="about-hero">
    <Image
      class="about-hero__photo"
      src={night}
      alt="Martín writing in his notebook at the dining table at night, under a warm lamp"
      widths={[480, 721]}
      sizes="(max-width: 767px) 100vw, 50vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="about-hero__text">
      <p class="eyebrow">Hi, I’m Martín</p>
      <h1 class="about-hero__title">I lead software teams. <span class="about-hero__accent">Here I write about it.</span></h1>
      <p class="lead about-hero__lead">I still catch myself trying to have every answer. I write here about that, and about what happens when I ask instead.</p>
      <div class="about-hero__actions">
        <a class="mw-button mw-button--primary" href="#contact">Let’s talk</a>
        <a class="about-link" href={site.linkedin} rel="me">Connect on LinkedIn ↗</a>
      </div>
    </div>
  </section>

  <section class="about-story" aria-labelledby="story-title">
    <div class="about-section-head">
      <h2 id="story-title" class="h2">How I got here</h2>
      <p class="lead about-muted">The short version, including the parts I’m not proud of.</p>
    </div>
    <ol class="about-timeline">
      {
        story.map((step) => (
          <li class:list={["about-step", step.today && "about-step--today"]}>
            <span class="about-step__dot" aria-hidden="true" />
            <span class="about-meta">{step.when}</span>
            <h3 class="about-step__title">{step.title}</h3>
            <p class="about-step__text">{step.text}</p>
            {step.link ? (
              <a class="about-link" href={step.link.href}>
                {step.link.label}
              </a>
            ) : null}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="about-work" aria-labelledby="work-title">
    <div class="about-work__grid">
      <div class="about-work__head">
        <h2 id="work-title" class="h2">How I work</h2>
        <p class="lead about-muted">Three ideas I keep coming back to.</p>
      </div>
      <ol class="about-work__list">
        {
          ideas.map((idea, index) => (
            <li class="about-idea">
              <span class="about-idea__num" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="about-step__title">{idea.title}</h3>
              <p class="about-step__text">{idea.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    start.length > 0 && (
      <section class="about-start" aria-labelledby="start-title">
        <div class="about-section-head">
          <h2 id="start-title" class="h2">
            Where to start
          </h2>
          <p class="lead about-muted">If you’re new here, start with one of these.</p>
        </div>
        <div class="about-start__grid">
          {start.map((post) => (
            <article class="about-card">
              <div class="about-meta about-card__meta">
                <TopicTag topic={post.data.topic} />
                <span>
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readTime(post.body ?? "")}
                </span>
              </div>
              <h3 class="about-step__title">
                <a class="about-card__title" href={`/${post.id}`}>
                  {post.data.title}
                </a>
              </h3>
              <p class="about-card__catch">{catchPhrase(post)}</p>
              <div class="about-card__foot">
                <span class="about-card__more" aria-hidden="true">
                  Keep reading <span class="about-card__arrow">→</span>
                </span>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <section id="contact" class="band" aria-labelledby="contact-title" slot="ending">
    <div class="contact-band">
      <div class="contact-band__copy">
        <p class="eyebrow band__eyebrow">Let’s talk</p>
        <h2 id="contact-title" class="band__title">Got a story like mine? Tell me about it.</h2>
        <p class="lead band__lead">I’m still figuring out how to put these ideas into practice. If you’re in the same spot, want to compare notes, or think I got something wrong, write to me.</p>
        <p class="contact-band__alt">Or find me on <a href={site.linkedin}>LinkedIn</a>.</p>
      </div>
      <div>
        <ContactForm variant="band" />
      </div>
    </div>
  </section>
</BaseLayout>
