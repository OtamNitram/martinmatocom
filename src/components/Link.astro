---
import Icon from "./Icon.astro";
import type { IconName } from "../lib/marks";

interface Props {
  href: string;
  external?: boolean;
  current?: boolean;
  icon?: boolean | IconName;
  class?: string;
}

const { href, external = false, current = false, icon, class: className } = Astro.props;
const iconName = icon === true ? "external-link" : icon;
---

<a
  class:list={["mw-link", className]}
  href={href}
  aria-current={current ? "page" : undefined}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  {iconName ? <Icon name={iconName} /> : null}
  <span><slot /></span>
</a>
