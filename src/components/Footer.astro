---
import Link from "./Link.astro";
import { footerNav } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="mw-footer">
  <span class="mw-footer__copy">© {year} Martín Mato</span>
  <hr class="mw-footer__divider" />
  <nav class="mw-footer__nav" aria-label="Footer">
    {footerNav.map((item) => <Link href={item.href}>{item.label}</Link>)}
  </nav>
</footer>
