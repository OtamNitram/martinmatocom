---
import Button from "./Button.astro";

interface Props {
  question: string;
  href: string;
}

const { question, href } = Astro.props;
---

<aside class="mw-closing">
  <h2 class="mw-closing__question">{question}</h2>
  <div>
    <Button href={href}>Send me a message</Button>
  </div>
  <p class="mw-closing__signoff">Thanks for reading.</p>
</aside>
