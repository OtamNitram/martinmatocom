---
/** The newsletter band that closes Blog, Post, Contact and Library, inside the dark ending. */
const action = import.meta.env.PUBLIC_BUTTONDOWN_ACTION ?? "";
---

<section id="newsletter" class="band" aria-labelledby="newsletter-title">
  <div class="news">
    <div class="news__copy">
      <p class="eyebrow band__eyebrow">Newsletter</p>
      <h2 id="newsletter-title" class="band__title">Get the next story in your inbox.</h2>
      <p class="lead band__lead">When I publish a new story, I’ll send it to you. Nothing else.</p>
    </div>
    <div>
      <form
        class="news__form"
        method="post"
        action={action || undefined}
        novalidate
        data-newsletter
        data-ready={action ? "true" : "false"}
        data-mode={action ? "fetch" : undefined}
      >
        <div class="news__row">
          <div class="mw-input">
            <label class="mw-input__label" for="newsletter-email">Email</label>
            <input class="mw-input__field" id="newsletter-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required />
          </div>
          <button class="mw-button mw-button--primary" type="submit">Subscribe</button>
        </div>
        <p class="band__msg" data-newsletter-error role="alert" hidden>Please add a valid email.</p>
        <p class="band__msg" data-newsletter-closed hidden>The list isn’t open yet.</p>
      </form>
      <div class="news__done" data-newsletter-done hidden role="status">
        <p class="band__thanks">You’re in.</p>
        <p class="lead band__lead" data-newsletter-address></p>
        <button class="mw-button mw-button--secondary" type="button" data-newsletter-reset>Use another email</button>
      </div>
    </div>
  </div>
</section>
<script>
  import "../scripts/newsletter.ts";
</script>
