---
import Chip from "./Chip.astro";
import type { Topic } from "../lib/posts";

interface Props {
  href: string;
  title: string;
  topic: Topic;
  date: string;
}

const { href, title, topic, date } = Astro.props;
---

<a class="mw-nextread" href={href}>
  <Chip topic={topic}>{topic}</Chip>
  <span class="mw-nextread__title">{title}</span>
  <span class="mw-nextread__date">{date}</span>
</a>
