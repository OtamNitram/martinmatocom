---
import PostCard from "./PostCard.astro";
import Chip from "./Chip.astro";
import Button from "./Button.astro";
import { topics, type Post } from "../lib/posts";

interface Props {
  posts: Post[];
  total: number;
  featured?: boolean;
  nextHref?: string;
}

const { posts, total, featured = false, nextHref } = Astro.props;
const label = total === 1 ? "1 post" : `${total} posts`;
---

<div data-filter>
  <div class="mw-tagfilter">
    <div class="mw-tagfilter__tags" role="group" aria-label="Filter posts by topic">
      <Chip toggle selected>All</Chip>
      {topics.map((topic) => <Chip toggle topic={topic}>{topic}</Chip>)}
    </div>
    <span class="mw-tagfilter__count" data-count>{label}</span>
  </div>
  <div class="post-list" data-post-list>
    {posts.map((post, index) => <PostCard post={post} featured={featured && index === 0} />)}
  </div>
  <p class="type-body post-list__empty" data-empty hidden>No stories in this topic yet.</p>
  {
    nextHref ? (
      <div class="post-list__more">
        <Button href={nextHref} variant="secondary">
          Older Entries
        </Button>
      </div>
    ) : null
  }
</div>
<script>
  import "../scripts/filter.ts";
</script>
