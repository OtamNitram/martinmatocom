---
import { ICONS, type IconName } from "../lib/marks";

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 18, label, class: className } = Astro.props;
const def = ICONS[name];
---

<svg
  class:list={["mw-icon", className]}
  width={size}
  height={size}
  viewBox={def.vb}
  fill="currentColor"
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
>
  {def.d.map((d) => <path d={d} />)}
</svg>
