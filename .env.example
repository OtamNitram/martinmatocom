# Copy to .env for local use, and set the same keys as build variables in Cloudflare (Workers & Pages > Settings > Build).
# Without them the forms stay on the page and say they are not open yet.

# Buttondown embed form. The welcome email, reply-to and RSS-to-email draft live in Buttondown, not here.
# PUBLIC_BUTTONDOWN_ACTION=https://buttondown.com/api/emails/embed-subscribe/your-username

# Formspree form that delivers to your inbox: used by the Contact page, About's contact band and a post's "Write to Martín".
# Do not put the inbox address in the page.
# PUBLIC_FORMSPREE_ACTION=https://formspree.io/f/xxxxxxxx

# Search Console HTML-tag verification. Not needed if the property is verified by DNS in Cloudflare.
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics: Umami Cloud. Its website id is public and lives in src/lib/site.ts (umamiWebsiteId); no key here.
