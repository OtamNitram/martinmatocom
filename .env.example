# Buttondown embed form. The welcome email, reply-to and RSS-to-email draft live in Buttondown, not here.
# PUBLIC_BUTTONDOWN_ACTION=https://buttondown.com/api/emails/embed-subscribe/your-username

# Formspree form that delivers to your inbox. Do not put the inbox address in the page.
# PUBLIC_FORMSPREE_ACTION=https://formspree.io/f/xxxxxxxx

# Search Console HTML-tag verification, once the domain points here.
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudflare Web Analytics token. Leave empty until the site is on Cloudflare.
# PUBLIC_CF_BEACON_TOKEN=
