// Cloudflare Workers, static assets only: `npm run build` writes dist/, `npx wrangler deploy` publishes it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "martinmatocom",
  "compatibility_date": "2026-11-01",
  // The site lives on martinmato.com (custom domains are set in the dashboard), so the public
  // *.workers.dev address and the per-version preview URLs stay off.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // /about answers 200 and /about/ redirects to it, so URLs match the canonical (no trailing slash).
    "html_handling": "drop-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  }
}
